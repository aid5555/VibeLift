# -----------------------------------------------------------------------------
# VibeLift environment configuration
# Copy this file to `.env.local` for local development.
# Never commit real secrets. Required keys are validated at startup by src/env.ts.
# -----------------------------------------------------------------------------

# --- Node / runtime ----------------------------------------------------------
NODE_ENV=development

# --- Database (SQLite, file-based) -------------------------------------------
# Canonical production path is mounted at /data inside the single container.
# For local development you may override with: file:./dev.db (relative to prisma/)
DATABASE_URL="file:/data/vibelift.db"

# --- Lyfta API (fitness data provider) ---------------------------------------
# REQUIRED: thrown at startup if missing/empty.
LYFTA_API_KEY=
LYFTA_BASE_URL="https://api.lyfta.com"

# --- AI / OpenCode (LLM function calling) ------------------------------------
# REQUIRED: thrown at startup if missing/empty.
AI_API_KEY=
AI_MODEL="gpt-4o-mini"
OPENCODE_BASE_URL="http://localhost:8787"

# --- Photo storage -----------------------------------------------------------
PHOTO_STORAGE_PATH="/data/photos"
MAX_PHOTO_UPLOAD_BYTES=10485760
